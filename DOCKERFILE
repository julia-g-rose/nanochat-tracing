FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# System deps. rustbpe now ships as a PyPI wheel, so no Rust toolchain/maturin
# build is needed anymore (unlike older nanochat).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive \
 apt-get install -y --no-install-recommends \
 python3 python3-dev python3-venv git curl ca-certificates cmake && \
 rm -rf /var/lib/apt/lists/*

# Install uv (used for dependency management, matching runs/speedrun.sh)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
 mv ~/.local/bin/uv /usr/local/bin/uv

WORKDIR /workspace

# Resolve dependencies into a fixed venv location. Do this before copying the
# rest of the source so the (slow) dependency layer is cached across code edits.
# --extra gpu selects the cu128 PyTorch index defined in pyproject.toml.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --extra gpu --frozen --no-install-project

# Copy the source and install the nanochat package itself into the same venv.
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --extra gpu --frozen

# torchao is required for --fp8 training (runs/speedrun.sh uses --fp8 at d24) but
# is not in the locked deps. Install it as a separate layer so the large
# locked-deps layer above stays cached and does not need re-pushing.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python torchao

# Put the venv on PATH so `python` / `torchrun` resolve without activation.
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# Default: run the full speedrun pipeline (pretrain -> SFT -> eval).
# The k8s Job overrides this with a shorter command for smoke-testing.
# NOTE: full eval (chat_eval) also needs the dev deps (transformers); add
# `--group dev` to the uv sync above if you run the whole pipeline in-container.
CMD ["bash", "runs/speedrun.sh"]
